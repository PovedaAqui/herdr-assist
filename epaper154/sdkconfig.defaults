# Comum às duas revisões da placa (V1 e V2). O que muda entre elas está em
# sdkconfig.defaults.v1 / .v2 (o modo da PSRAM).
#
# 4 MB de flash nas duas: a V2 tem 8 MB, mas o firmware (~1 MB) cabe com folga
# em dois slots OTA de 1,94 MB, e um só layout serve às duas — o mesmo que o
# exemplo oficial da V2 configura. Sem este arquivo o IDF gerava 2 MB e PSRAM
# desligada, e o bootloader recusaria a tabela de partições.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
# placa errada (V1 com firmware da V2 ou vice-versa) sobe sem PSRAM em vez de
# entrar em boot loop; o herdr_conn cai para malloc
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
# herdados do sdkconfig.defaults do painel (mesmos motivos)
CONFIG_FREERTOS_HZ=1000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# portal (httpd) + ponte + pareamento + descoberta
CONFIG_LWIP_MAX_SOCKETS=16
# bateria: light sleep automático entre eventos (esp_pm_configure no
# app_main), suspenso enquanto um PC estiver na USB para o log continuar
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
